{
  "name": "@figit/browser-capture-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared browser capture preparation for DOM-to-Figma consumers.",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "biome check",
    "prepare": "tsdown"
  },
  "peerDependencies": {
    "@figit/dom-to-figma": ">=0.2.0 <0.4.0"
  },
  "dependencies": {
    "@figit/composed-dom": "workspace:*",
    "fontkit": "^2.0.4"
  },
  "devDependencies": {
    "@figit/dom-to-figma": "workspace:*",
    "@types/fontkit": "^2.0.9",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "^4.1.5",
    "playwright": "^1.50.0",
    "tsdown": "^0.21.0",
    "typescript": "catalog:",
    "vitest": "^4.1.5"
  }
}
