{
  "name": "@figit/composed-dom",
  "version": "0.1.1",
  "description": "Browser DOM tree strategies for light and open composed trees.",
  "license": "MIT",
  "author": "Figit <https://figit.design>",
  "homepage": "https://github.com/figitdesign/web-to-figma#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figitdesign/web-to-figma.git",
    "directory": "packages/composed-dom"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "biome check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "^4.1.5",
    "playwright": "^1.50.0",
    "tsdown": "^0.21.0",
    "typescript": "catalog:",
    "vitest": "^4.1.5"
  }
}
