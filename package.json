{
  "name": "figma",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source tools for moving designs between the browser and Figma.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "pnpm test:upstream-core-delta && pnpm -r run test",
    "check-types": "pnpm -r run check-types",
    "lint": "biome check",
    "format": "biome check --write",
    "knip": "knip",
    "oracle:capture": "pnpm --filter @figit/fig-kiwi oracle:capture",
    "oracle:outbox": "pnpm --filter @figit/dom-to-figma oracle:outbox",
    "changeset": "changeset",
    "release": "pnpm build && pnpm changeset publish",
    "oracle:diff": "pnpm --filter @figit/fig-kiwi oracle:diff",
    "oracle:distill": "pnpm --filter @figit/fig-kiwi oracle:distill",
    "oracle:parity": "pnpm --filter @figit/oracle-harness run parity",
    "oracle:figma-run": "pnpm --filter @figit/oracle-harness run cli figma",
    "oracle:calibrate": "pnpm --filter @figit/oracle-harness run cli calibrate",
    "oracle:loop": "bash scripts/oracle-loop.sh",
    "upstream-core-delta:check": "node scripts/check-upstream-core-delta.mjs",
    "upstream-core-delta:update": "node scripts/check-upstream-core-delta.mjs --update-fingerprints",
    "upstream-core-delta:stable": "node scripts/check-upstream-core-delta.mjs --target stable",
    "upstream-core-delta:main": "node scripts/check-upstream-core-delta.mjs --target upstream-main",
    "upstream-adapter:stable": "node scripts/check-vanilla-upstream-adapter.mjs",
    "upstream-adapter:main": "node scripts/check-upstream-main-adapter.mjs",
    "test:upstream-core-delta": "node --test scripts/check-upstream-core-delta.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.27.13",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^21.0.1",
    "knip": "^6.14.1",
    "lefthook": "^2.1.6",
    "pkg-pr-new": "^0.0.70",
    "ultracite": "7.6.3"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  }
}
